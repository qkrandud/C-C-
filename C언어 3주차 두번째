#include <stdio.h>

int main() {
    int score;
    printf("결과 점수를 입력하세요(0~100): ");
    scanf("%d",&score);

    switch(score / 10) {
        // 10으로 나누어 떨어지지 않아도 정수로만 표현하기에 소수점 숫자는 없다
        case 10:
        case 9: printf("학점은 A");break;

        case 8:
        case 7: printf("학점은 B");break;
        
        case 6:
        case 5: printf("학점은 C");break;

        default: printf("학점은 F");

        return 0;
    }
}
