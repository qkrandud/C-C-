#include <stdio.h>

int main() {
    int year;
    printf("연도를 입력하십시오 :");
    scanf("%d",&year);
    
    if(year % 4 == 0 && year % 100 == 0) {
        printf("윤년이 아닙니다");
    }
    else if(year % 4 == 0 || year % 400 == 0) {
        printf("윤년입니다");
    }
    else {
        printf("평년입니다");
    }
    return 0;
}
